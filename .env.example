APP_NAME=AI Fatah Online Store
DEBUG=true
SECRET_KEY=replace-this-with-a-long-random-secret

# PostgreSQL (recommended)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_fatah_store

# Use true only locally if you want tables created automatically.
# For production, use Alembic migrations and set this to false.
AUTO_CREATE_TABLES=true

# WhatsApp number with country code, but without +, spaces or dashes.
WHATSAPP_NUMBER=923001234567

ADMIN_EMAIL=admin@aifatah.pk
ADMIN_PASSWORD=ChangeMe123!

SESSION_HTTPS_ONLY=false
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
